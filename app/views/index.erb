<form id="new-paste" method="post" action="/create">
  <% if defined?(error_message) && error_message %>
    <div id="snackbar-container">
      <p class="form-snackbar" role="alert"><%= error_message %></p>
    </div>
  <% end %>
  <div id="paste-block">
    <div id="paste-editor"></div>
    <textarea name="paste[content]" id="paste-content-hidden" style="display: none;"></textarea>
  </div>

  <div id="panel-block">
    <%= erb :'/partial/menu' %>

    <div id="form-options">
      <label for="lang">Language Type</label>
      <select id="lang" name="paste[lang]">
        <% for item in lang %>
	<option value="<%= item[:key] %>"><%= item[:name] %></option>
        <% end %>
      </select>

      <label class="protected-option" for="protected">
        <input id="protected" type="checkbox" name="paste[protected]" value="1">
        Protected
      </label>

      <div id="password-option">
        <label for="paste-password">Password</label>
        <input id="paste-password" type="password" name="paste[password]" autocomplete="new-password">
      </div>
    </div>

    <div id="form-action">
      <input type="submit">
    </div>

    <div class="sidebar-block">
      <h4>Recent Pastes</h4>
      <ul class="recent-pastes-list">
        <% if recent_pastes.any? %>
          <% recent_pastes.each do |paste| %>
            <li>
              <a href="/<%= paste.slug %>"><i class="fas fa-file-alt"></i><%= paste.slug %><% if paste.private? %> <i class="fas fa-lock" title="Protected paste" aria-label="Protected paste"></i><% end %></a><br>
              <small style="color: #D7D7D7"><%= format_time_ago(paste.created_at) %></small><br>
              <small style="color: #D7D7D7"><%= format_content_size(paste.content) %>, <%= paste.lang %></small>
            </li>
          <% end %>
        <% else %>
          <li>No recent pastes.</li>
        <% end %>
      </ul>
    </div>
  </div>
</form>
